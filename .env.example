# Публичные адреса (не секреты)
PUBLIC_APP_URL=https://example.com
GOOGLE_REDIRECT_URI=https://example.com/api/google/callback
TELEGRAM_BOT_USERNAME=example_bot
ALLOWED_ORIGINS=https://example.com,https://ev87st2-bit.github.io

# Telegram — хранить только в защищённых переменных среды
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Оставить пустым для семейного режима; заполнить только для ограничения одним чатом.
TELEGRAM_ALLOWED_CHAT_ID=

# Google OAuth Web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32 случайных байта в base64 для AES-GCM
TOKEN_ENCRYPTION_KEY=

# Явно выбранный OpenAI-совместимый провайдер (не обещает постоянную бесплатность)
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
TRANSCRIPTION_MODEL=

# Ручной защищённый запуск проверки напоминаний, если Cron Trigger недоступен
CRON_SECRET=
